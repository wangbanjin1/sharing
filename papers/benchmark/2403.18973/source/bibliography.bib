isbn = {978-0-521-67758-5 (Paperback); 978-0-521-86023-9 (Hardcover)},
keywords = {*Human Channel Capacity,*Learning Environment,Theories},
pages = {vii, 275--vii, 275},
publisher = {Cambridge University Press},
title = {{Cognitive load theory.}},
