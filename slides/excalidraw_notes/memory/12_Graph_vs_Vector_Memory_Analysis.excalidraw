    {
      "id": "txt_0094",
      "type": "text",
      "x": 92,
      "y": 2734,
      "width": 821.9,
      "height": 46.1,
      "angle": 0,
      "strokeColor": "#0b7285",
      "backgroundColor": "transparent",
