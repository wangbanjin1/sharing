    {
      "id": "txt_0030",
      "type": "text",
      "x": 2384,
      "y": 428,
      "width": 746.3,
      "height": 46.1,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
