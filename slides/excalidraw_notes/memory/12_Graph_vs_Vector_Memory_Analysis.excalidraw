      "text": "核心区别 · 不是图库对比向量库，而是三处机制取舍",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "核心区别 · 不是图库对比向量库，而是三处机制取舍",
      "lineHeight": 1.38
    },
    {
      "id": "txt_0006",
      "type": "text",
      "x": 62,
      "y": 242,
      "width": 690,
      "height": 100,
      "angle": 0,
      "strokeColor": "#2b3035",
      "backgroundColor": "transparent",
