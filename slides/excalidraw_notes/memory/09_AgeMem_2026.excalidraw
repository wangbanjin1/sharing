      "isDeleted": false,
      "boundElements": [],
      "updated": 1795360018465,
      "link": null,
      "locked": false,
      "text": "1. 解决什么问题",
      "fontSize": 36,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 解决什么问题",
      "lineHeight": 1.28,
      "autoResize": true
    },
    {
      "id": "txt_0026",
      "type": "text",
      "x": 2384,
      "y": 488.1,
      "width": 2377.3,
      "height": 92.4,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 208186281,
      "version": 1,
      "versionNonce": 937859570,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795360018465,
      "link": null,
      "locked": false,
      "text": "现有记忆框架通常把长期记忆（LTM）与短期工作记忆（STM）拆成割裂组件，依赖手工触发规则或外置静态控制器，既无法根据任务需要动态裁剪干扰上下文，也无法端到端协同优化「\n存什么、留什么、检什么」。",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "现有记忆框架通常把长期记忆（LTM）与短期工作记忆（STM）拆成割裂组件，依赖手工触发规则或外置静态控制器，既无法根据任务需要动态裁剪干扰上下文，也无法端到端协同优化「\n存什么、留什么、检什么」。",
      "lineHeight": 1.65,
      "autoResize": true
    },
    {
      "id": "rect_0027",
      "type": "rectangle",
      "x": 2356,
      "y": 632,
      "width": 2436,
