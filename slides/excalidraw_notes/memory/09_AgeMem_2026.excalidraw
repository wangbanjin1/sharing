    },
    {
      "id": "txt_0023",
      "type": "text",
      "x": 2360,
      "y": 354,
      "width": 1277.4,
      "height": 38.1,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
