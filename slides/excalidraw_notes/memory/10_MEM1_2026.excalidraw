      "text": "1. 解决什么问题",
      "fontSize": 36,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 解决什么问题",
      "lineHeight": 1.28,
      "autoResize": true
    },
    {
      "id": "txt_0026",
      "type": "text",
      "x": 2384,
      "y": 488.1,
      "width": 2293.3,
      "height": 46.2,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 208186281,
      "version": 1,
      "versionNonce": 937859570,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795360018465,
      "link": null,
      "locked": false,
      "text": "多轮搜索、深研与网页交互智能体通常不断把历史思考、查询与环境返回全量追加进上下文，导致显存与计算成本线性膨胀，且一旦超过训练长度分布即出现严重的推理性能退化。",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "多轮搜索、深研与网页交互智能体通常不断把历史思考、查询与环境返回全量追加进上下文，导致显存与计算成本线性膨胀，且一旦超过训练长度分布即出现严重的推理性能退化。",
      "lineHeight": 1.65,
      "autoResize": true
    },
