    {
      "id": "txt_0030",
      "type": "text",
      "x": 2384,
      "y": 428,
      "width": 265.4,
      "height": 46.1,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
