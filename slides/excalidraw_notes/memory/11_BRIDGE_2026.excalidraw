    },
    {
      "id": "txt_0092",
      "type": "text",
      "x": 2496,
      "y": 2865.1,
      "width": 2293.8,
      "height": 174.7,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
