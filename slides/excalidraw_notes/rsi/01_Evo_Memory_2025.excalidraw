			"text": "1. 解决什么问题",
			"fontSize": 36,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. 解决什么问题",
			"lineHeight": 1.28,
			"autoResize": true,
			"index": "aT",
			"created": null,
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null,
			"baseFontSize": null
		},
		{
			"id": "txt_0031",
			"type": "text",
			"x": 2384,
			"y": 488.1,
			"width": 2245.5604788506193,
			"height": 124.64290886311504,
			"angle": 0,
			"strokeColor": "#212529",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"seed": 684561670,
			"version": 10,
			"versionNonce": 2034650076,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795419268075,
			"link": null,
			"locked": false,
			"text": "1. 现有记忆评测（如 LoCoMo、LongMemEval）主要测静态对话事实回忆，Agent 记住了「说过什么」却没学会「怎么解同类新题」；\n2. 缺少统一的流式测试时进化评测框架，导致检索型、工作流型、分层记忆等 10 余类方法无法在同一任务流协议下公平对比。",
			"fontSize": 37.77057844336821,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. 现有记忆评测（如 LoCoMo、LongMemEval）主要测静态对话事实回忆，Agent 记住了「说过什么」却没学会「怎么解同类新题」；\n2. 缺少统一的流式测试时进化评测框架，导致检索型、工作流型、分层记忆等 10 余类方法无法在同一任务流协议下公平对比。",
			"lineHeight": 1.65,
			"autoResize": true,
			"index": "aU",
			"created": null,
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null,
			"baseFontSize": null
		},
