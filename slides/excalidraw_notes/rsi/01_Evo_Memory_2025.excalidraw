		{
			"id": "txt_0034",
			"type": "text",
			"x": 2384,
			"y": 743.1000000000001,
			"width": 1954.90990272657,
			"height": 168.53984394432106,
			"angle": 0,
			"strokeColor": "#212529",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
