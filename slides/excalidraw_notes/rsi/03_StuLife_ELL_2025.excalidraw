      "verticalAlign": "top",
      "containerId": null,
      "originalText": "打破传统 Agent 评测短视、孤立、纯被动响应的局限，用连贯有状态的真实长周期环境衡量终身自进化能力",
      "lineHeight": 1.36,
      "autoResize": true
