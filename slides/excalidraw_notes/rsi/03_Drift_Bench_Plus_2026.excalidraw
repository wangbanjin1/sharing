			"autoResize": true
		},
		{
			"id": "txt_0034",
			"type": "text",
			"x": 2384,
			"y": 743.1,
			"width": 2145.64,
			"height": 138.6,
			"angle": 0,
			"strokeColor": "#212529",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"seed": 1916010461,
			"version": 2,
			"versionNonce": 128698575,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795362535549,
			"link": null,
			"locked": false,
			"text": "• 覆盖三类可执行环境：WebShop（1,780 样本 / 257 图）、τ²-Retail（555 样本 / 98 图）、τ²-Airline（208 样本 / 40 图），兼顾网页搜索与写操作工具调用；\n• 四类 11 种沟通缺陷：覆盖意图、前提、参数与表达四类失配，支持单缺陷及多缺陷叠加（k=1..4）复合压力测试；\n• 状态机驱动的五类 GDMS 画像：理性、直觉、依赖、回避、随性五种风格，由确定性状态机硬调控披露率、初始耐心与漂移倾向，不靠 LLM 自由发挥。",
			"fontSize": 28,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "• 覆盖三类可执行环境：WebShop（1,780 样本 / 257 图）、τ²-Retail（555 样本 / 98 图）、τ²-Airline（208 样本 / 40 图），兼顾网页搜索与写操作工具调用；\n• 四类 11 种沟通缺陷：覆盖意图、前提、参数与表达四类失配，支持单缺陷及多缺陷叠加（k=1..4）复合压力测试；\n• 状态机驱动的五类 GDMS 画像：理性、直觉、依赖、回避、随性五种风格，由确定性状态机硬调控披露率、初始耐心与漂移倾向，不靠 LLM 自由发挥。",
			"lineHeight": 1.65,
			"autoResize": true
		},
